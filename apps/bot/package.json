{
  "name": "@piphacklup/bot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm --filter @piphacklup/db build && tsc -p tsconfig.json",
    "check": "pnpm typecheck",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "pnpm typecheck",
    "predev": "pnpm --filter @piphacklup/db build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "pnpm --filter @piphacklup/db build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@piphacklup/core": "workspace:*",
    "@piphacklup/db": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
